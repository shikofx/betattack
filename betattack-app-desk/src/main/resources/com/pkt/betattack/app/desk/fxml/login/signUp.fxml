<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="400.0" prefWidth="700.0" style="-fx-background-color: #2E3348;"
            xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pkt.bet.desk.controllers.SignUpController">
    <children>
        <AnchorPane layoutX="-18.0" layoutY="68.0" prefHeight="332.0" prefWidth="724.0"
                    style="-fx-background-color: FAFAFA;">
            <children>
                <TextField fx:id="userNameField" layoutX="42.0" layoutY="30.0" prefHeight="39.0" prefWidth="307.0"
                           promptText="Login"
                           style="-fx-background-color: #FAFAFA; -fx-border-color: silver; -fx-border-radius: 3; -fx-border-width: 1;">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </TextField>
                <Button fx:id="submitButton" layoutX="567.0" layoutY="256.0" mnemonicParsing="false" prefHeight="44.0"
                        prefWidth="129.0" style="-fx-background-color: #F39458;" text="OK" textFill="#ebebeb"
                        textOverrun="WORD_ELLIPSIS" underline="true">
                    <font>
                        <Font name="Book Antiqua" size="16.0"/>
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </Button>
                <PasswordField fx:id="passwordField" layoutX="42.0" layoutY="108.0" prefHeight="42.0" prefWidth="307.0"
                               promptText="Password"
                               style="-fx-background-color: #FAFAFA; -fx-border-radius: 3; -fx-border-color: silver; -fx-border-width: 1;">
                    <font>
                        <Font size="19.0"/>
                    </font>
                </PasswordField>
                <PasswordField fx:id="passwordConfField" layoutX="42.0" layoutY="185.0" prefHeight="42.0"
                               prefWidth="307.0" promptText="Password Confirmation"
                               style="-fx-background-color: #FAFAFA; -fx-border-radius: 3; -fx-border-color: silver; -fx-border-width: 1;">
                    <font>
                        <Font size="19.0"/>
                    </font>
                </PasswordField>
                <Label fx:id="errorLabel" layoutX="42.0" layoutY="242.0" prefHeight="71.0" prefWidth="307.0"/>
                <TextField fx:id="firstNameField" layoutX="389.0" layoutY="30.0" prefHeight="39.0" prefWidth="307.0"
                           promptText="First Name"
                           style="-fx-background-color: #FAFAFA; -fx-border-color: silver; -fx-border-radius: 3; -fx-border-width: 1;">
                    <font>
                        <Font size="18.0"/>
                    </font>
                    <cursor>
                        <Cursor fx:constant="DEFAULT"/>
                    </cursor>
                </TextField>
                <TextField fx:id="lastNameField" layoutX="389.0" layoutY="109.0" prefHeight="39.0" prefWidth="307.0"
                           promptText="Last Name"
                           style="-fx-background-color: #FAFAFA; -fx-border-color: silver; -fx-border-radius: 3; -fx-border-width: 1;">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </TextField>
                <CheckBox fx:id="maleRadioButton" layoutX="387.0" layoutY="193.0" mnemonicParsing="false" text="Male">
                    <font>
                        <Font size="19.0"/>
                    </font>
                </CheckBox>
                <CheckBox fx:id="femaleRadioButton" layoutX="602.0" layoutY="193.0" mnemonicParsing="false"
                          text="Female">
                    <font>
                        <Font size="19.0"/>
                    </font>
                </CheckBox>
                <Button fx:id="canselButton" layoutX="414.0" layoutY="256.0" mnemonicParsing="false" prefHeight="44.0"
                        prefWidth="129.0" style="-fx-background-color: #F39458;" text="Cansel" textFill="#f2f2f2"
                        textOverrun="WORD_ELLIPSIS">
                    <font>
                        <Font name="Book Antiqua" size="16.0"/>
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </Button>
            </children>
        </AnchorPane>
        <Label layoutX="225.0" text="PKT Bets" textFill="#ebebeb">
            <font>
                <Font name="Book Antiqua Bold" size="56.0"/>
            </font>
        </Label>
        <ImageView fitHeight="59.0" fitWidth="61.0" layoutX="11.0" layoutY="4.0" pickOnBounds="true"
                   preserveRatio="true">
            <image>
                <Image url="@../../../../../../../../../build/resources/main/com/pkt/betattack/app/desk/images/betting.png"/>
            </image>
        </ImageView>
    </children>
</AnchorPane>
