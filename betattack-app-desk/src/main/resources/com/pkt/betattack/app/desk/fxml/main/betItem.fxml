<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<AnchorPane fx:id="betPane" maxHeight="30.0" minHeight="30.0" minWidth="-Infinity" prefHeight="30.0"
            xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pkt.betattack.app.desk.controllers.main.BetItemController">
    <userData>
        <fx:reference source="controller"></fx:reference>
    </userData>
    <children>
        <VBox fx:id="betBox" alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="655.0"
              style="-fx-background-color: #FBEBCD;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <GridPane fx:id="betGrid" alignment="CENTER_LEFT" nodeOrientation="LEFT_TO_RIGHT" prefHeight="29.0"
                          prefWidth="687.0" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="100.0" minWidth="32.0"
                                           prefWidth="32.0"/>
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="454.0" minWidth="68.0"
                                           prefWidth="68.0"/>
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="472.0" minWidth="67.0"
                                           prefWidth="67.0"/>
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="246.0" minWidth="50.0"
                                           prefWidth="70.0"/>
                        <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" maxWidth="246.0" minWidth="100.0"
                                           prefWidth="126.0"/>
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="234.0" minWidth="46.0"
                                           prefWidth="46.0"/>
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="248.0" minWidth="60.0"
                                           prefWidth="67.0"/>
                        <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" maxWidth="600.0" minWidth="100.0"
                                           prefWidth="169.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <RadioButton fx:id="addToAttackButton" contentDisplay="CENTER" mnemonicParsing="false"
                                     onAction="#changeAttackStatus" selected="false">
                            <tooltip>
                                <Tooltip text="Добавить к атаке"/>
                            </tooltip>
                        </RadioButton>
                        <Text fx:id="betName" strokeType="OUTSIDE" strokeWidth="0.0" text="Пенальти"
                              wrappingWidth="94.0" GridPane.columnIndex="4">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                            <GridPane.margin>
                                <Insets left="5.0"/>
                            </GridPane.margin>
                        </Text>
                        <Label fx:id="betSign" ellipsisString="" text="&lt;" GridPane.columnIndex="5">
                            <tooltip>
                                <Tooltip fx:id="betSignTooltip" graphicTextGap="2.0" opacity="0.46" text="Меньше"/>
                            </tooltip>
                        </Label>
                        <Text fx:id="betRateValue" strokeType="OUTSIDE" strokeWidth="0.0" text="1,12"
                              textAlignment="CENTER" wrappingWidth="59.0" GridPane.columnIndex="6">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Text>
                        <TextField fx:id="attackSumField" alignment="CENTER" maxWidth="80.0" minWidth="58.0"
                                   onKeyTyped="#setBetSum" onMouseClicked="#clickToBetField" prefHeight="25.0"
                                   prefWidth="58.0" promptText="Сумма" GridPane.columnIndex="2">
                            <tooltip>
                                <Tooltip fx:id="sumTooltip" contentDisplay="CENTER" opacity="0.5" text="Сумма ставки"
                                         textAlignment="CENTER"/>
                            </tooltip>
                            <opaqueInsets>
                                <Insets left="3.0" right="3.0"/>
                            </opaqueInsets>
                            <GridPane.margin>
                                <Insets left="3.0" right="3.0"/>
                            </GridPane.margin>
                        </TextField>
                        <ProgressBar fx:id="progressBar" maxWidth="1.7976931348623157E308" minWidth="80.0"
                                     nodeOrientation="LEFT_TO_RIGHT" opacity="0.66" prefWidth="133.0" progress="0.0"
                                     GridPane.columnIndex="7" GridPane.halignment="LEFT" GridPane.hgrow="ALWAYS">
                            <GridPane.margin>
                                <Insets left="2.0" right="2.0"/>
                            </GridPane.margin>
                            <padding>
                                <Insets left="2.0" right="2.0"/>
                            </padding>
                            <tooltip>
                                <Tooltip fx:id="progressBarTooltip" opacity="0.5" text="Ждем ставку"/>
                            </tooltip>
                        </ProgressBar>
                        <Hyperlink fx:id="accountsInAttack" onAction="#openAccountsInAttack" opacity="0.68"
                                   text="Accounts: 0 / 0" textAlignment="CENTER" textFill="#250101"
                                   GridPane.columnIndex="7">
                            <effect>
                                <Blend/>
                            </effect>
                        </Hyperlink>
                        <HBox alignment="CENTER" prefHeight="29.0" prefWidth="65.0" spacing="3.0"
                              GridPane.columnIndex="1">
                            <children>
                                <ToggleButton fx:id="startAttackButton" maxHeight="25.0" maxWidth="30.0"
                                              minHeight="25.0" minWidth="30.0" onAction="#startAttack" prefHeight="25.0"
                                              prefWidth="30.0" textAlignment="CENTER">
                                    <graphic>
                                        <ImageView fitHeight="27.0" fitWidth="27.0" nodeOrientation="INHERIT">
                                            <image>
                                                <Image url="@../../images/start.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="stopAttackButton" maxHeight="25.0" maxWidth="30.0" minHeight="25.0"
                                              minWidth="30.0" onAction="#stopAttack" prefHeight="25.0" prefWidth="30.0">
                                    <graphic>
                                        <ImageView fitHeight="25.0" fitWidth="27.0" nodeOrientation="INHERIT">
                                            <image>
                                                <Image url="@../../images/stop.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </ToggleButton>
                            </children>
                            <opaqueInsets>
                                <Insets top="2.0"/>
                            </opaqueInsets>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="3">
                            <children>
                                <Label alignment="TOP_LEFT" prefHeight="30.0" prefWidth="21.0" text="min"/>
                                <TextField fx:id="minKoefficient" alignment="CENTER" maxWidth="40.0" minWidth="20.0"
                                           onKeyTyped="#setMinKoefficient" onMouseClicked="#clickToBetField"
                                           prefHeight="25.0" promptText="min" text="1.09">
                                    <tooltip>
                                        <Tooltip fx:id="minKoefficientToolTip" autoHide="true" contentDisplay="CENTER"
                                                 opacity="0.5" text="Мин. Коэффициент" textAlignment="CENTER"/>
                                    </tooltip>
                                    <opaqueInsets>
                                        <Insets left="3.0" right="3.0"/>
                                    </opaqueInsets>
                                </TextField>
                            </children>
                            <opaqueInsets>
                                <Insets/>
                            </opaqueInsets>
                            <GridPane.margin>
                                <Insets left="5.0" right="2.0"/>
                            </GridPane.margin>
                        </HBox>
                    </children>
                    <VBox.margin>
                        <Insets/>
                    </VBox.margin>
                </GridPane>
            </children>
            <padding>
                <Insets left="5.0" right="5.0"/>
            </padding>
        </VBox>
    </children>
    <opaqueInsets>
        <Insets/>
    </opaqueInsets>
</AnchorPane>
