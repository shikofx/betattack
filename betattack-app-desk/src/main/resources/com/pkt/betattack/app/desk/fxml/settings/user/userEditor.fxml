<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<GridPane fx:id="editorGridPane" scaleShape="false" style="-fx-background-radius: 1em;" StackPane.alignment="TOP_LEFT"
          xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.pkt.betattack.app.desk.controllers.settings.user.UserEditorController">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints maxHeight="1.7976931348623157E308" minHeight="10.0" prefHeight="497.0" vgrow="SOMETIMES"/>
    </rowConstraints>
    <children>
        <VBox fx:id="editorBox" alignment="TOP_CENTER" spacing="16.0">
            <children>
                <GridPane alignment="BOTTOM_CENTER" depthTest="DISABLE" maxHeight="1.7976931348623157E308"
                          maxWidth="1.7976931348623157E308" prefHeight="253.0" prefWidth="728.0"
                          style="-fx-border-color: #0087D1; -fx-border-radius: 1em;">
                    <columnConstraints>
                        <ColumnConstraints halignment="CENTER" maxWidth="1.7976931348623157E308" minWidth="500.0"
                                           prefWidth="565.0"/>
                        <ColumnConstraints halignment="CENTER" maxWidth="360.0" minWidth="160.0" prefWidth="163.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="60.0" minHeight="60.0" prefHeight="60.0" valignment="CENTER"/>
                    </rowConstraints>
                    <children>
                        <VBox prefHeight="42.0" prefWidth="400.0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1"
                              GridPane.valignment="BASELINE">
                            <children>
                                <Text fx:id="loginWarning" fill="#b90909" strokeType="OUTSIDE" strokeWidth="0.0"
                                      text="* Введите свое имя" visible="false">
                                    <font>
                                        <Font size="10.0"/>
                                    </font>
                                    <VBox.margin>
                                        <Insets left="32.0" right="32.0" top="8.0"/>
                                    </VBox.margin>
                                </Text>
                                <TextField fx:id="nameField" onKeyTyped="#userNameTypeText"
                                           promptText="Имя пользователя" VBox.vgrow="ALWAYS">
                                    <VBox.margin>
                                        <Insets bottom="8.0" left="32.0" right="32.0" top="8.0"/>
                                    </VBox.margin>
                                </TextField>
                            </children>
                        </VBox>
                        <VBox prefHeight="42.0" prefWidth="658.0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2">
                            <children>
                                <Text fx:id="emailWarning" fill="#b90909" strokeType="OUTSIDE" strokeWidth="0.0"
                                      text="* Введите почтовый ящик" visible="false">
                                    <font>
                                        <Font size="10.0"/>
                                    </font>
                                    <VBox.margin>
                                        <Insets left="32.0" right="32.0" top="8.0"/>
                                    </VBox.margin>
                                </Text>
                                <TextField fx:id="emailField" onKeyTyped="#emailTypeText" promptText="user@email.com">
                                    <VBox.margin>
                                        <Insets bottom="8.0" left="32.0" right="32.0" top="8.0"/>
                                    </VBox.margin>
                                </TextField>
                            </children>
                        </VBox>
                        <VBox prefHeight="42.0" prefWidth="658.0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3">
                            <children>
                                <Text fx:id="passwordWarning" fill="#b90909" strokeType="OUTSIDE" strokeWidth="0.0"
                                      text="* Введите пароль" visible="false">
                                    <font>
                                        <Font size="10.0"/>
                                    </font>
                                    <VBox.margin>
                                        <Insets left="32.0" right="32.0" top="8.0"/>
                                    </VBox.margin>
                                </Text>
                                <TextField fx:id="passwordField" accessibleRole="PASSWORD_FIELD"
                                           onKeyTyped="#passwordTypeText" promptText="Пароль. Минимум 8 символов">
                                    <VBox.margin>
                                        <Insets left="32.0" right="32.0" top="8.0"/>
                                    </VBox.margin>
                                </TextField>
                            </children>
                        </VBox>
                        <VBox prefHeight="42.0" prefWidth="658.0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="4">
                            <children>
                                <Text fx:id="passwordConfirmWarning" fill="#b90909" strokeType="OUTSIDE"
                                      strokeWidth="0.0" text="* Подтвердите пароль" visible="false">
                                    <font>
                                        <Font size="10.0"/>
                                    </font>
                                    <VBox.margin>
                                        <Insets left="32.0" right="32.0" top="8.0"/>
                                    </VBox.margin>
                                </Text>
                                <TextField fx:id="passwordConfirmField" accessibleRole="PASSWORD_FIELD"
                                           onKeyTyped="#passwordConfirmationTypeText" promptText="Повторите пароль">
                                    <VBox.margin>
                                        <Insets left="32.0" right="32.0" top="8.0"/>
                                    </VBox.margin>
                                </TextField>
                            </children>
                        </VBox>
                        <Button fx:id="resetButton" alignment="CENTER" cancelButton="true" contentDisplay="CENTER"
                                minHeight="32.0" minWidth="96.0" mnemonicParsing="false" onAction="#resetUserToCurrent"
                                prefHeight="32.0" prefWidth="96.0" text="Сброс" textAlignment="CENTER"
                                GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.valignment="BOTTOM">
                            <GridPane.margin>
                                <Insets/>
                            </GridPane.margin>
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Button>
                        <Button fx:id="saveButton" minHeight="32.0" minWidth="96.0" mnemonicParsing="false"
                                onAction="#saveUser" prefHeight="32.0" prefWidth="96.0" text="Сохранить"
                                textAlignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                GridPane.valignment="BOTTOM">
                            <font>
                                <Font size="14.0"/>
                            </font>
                            <GridPane.margin>
                                <Insets/>
                            </GridPane.margin>
                        </Button>
                        <Button fx:id="addButton" alignment="CENTER" cancelButton="true" contentDisplay="CENTER"
                                minHeight="32.0" minWidth="96.0" mnemonicParsing="false" onAction="#addUser"
                                prefHeight="32.0" prefWidth="96.0" text="Добавить" textAlignment="CENTER"
                                GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.valignment="BOTTOM">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Button>
                        <Button fx:id="deleteButton" alignment="CENTER" cancelButton="true" contentDisplay="CENTER"
                                minHeight="32.0" minWidth="96.0" mnemonicParsing="false" onAction="#deleteUser"
                                prefHeight="32.0" prefWidth="96.0" text="Удалить" textAlignment="CENTER"
                                GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.valignment="BOTTOM">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Button>
                    </children>
                    <cursor>
                        <Cursor fx:constant="DEFAULT"/>
                    </cursor>
                    <VBox.margin>
                        <Insets/>
                    </VBox.margin>
                    <padding>
                        <Insets bottom="32.0" left="8.0" right="8.0" top="8.0"/>
                    </padding>
                </GridPane>
                <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" pannable="true"
                            style="-fx-border-color: #0087D1; -fx-background-color: #23AAF2; -fx-border-radius: 1em;"
                            vbarPolicy="ALWAYS" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets/>
                    </VBox.margin>
                    <content>
                        <VBox fx:id="userListBox" alignment="TOP_CENTER" maxWidth="1.7976931348623157E308"
                              minWidth="646.0" prefHeight="297.0" prefWidth="694.0" spacing="8.0"
                              style="-fx-background-color: #23AAF2;">
                            <opaqueInsets>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                            </opaqueInsets>
                            <effect>
                                <Blend/>
                            </effect>
                            <cursor>
                                <Cursor fx:constant="DEFAULT"/>
                            </cursor>
                        </VBox>
                    </content>
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                    </padding>
                </ScrollPane>
            </children>
            <opaqueInsets>
                <Insets/>
            </opaqueInsets>
        </VBox>
    </children>
    <StackPane.margin>
        <Insets/>
    </StackPane.margin>
</GridPane>
